# Optional. A fine-grained GitHub token with NO scopes (public data only).
# Raises the GitHub API rate limit from 60 to 5,000 requests/hour for the
# GitHub_Activity section. The site works without it.
GITHUB_TOKEN=

# Optional. Public URL of the deployed site, used for metadata/OpenGraph.
NEXT_PUBLIC_SITE_URL=https://caleb-kilemba-portfolio.vercel.app
